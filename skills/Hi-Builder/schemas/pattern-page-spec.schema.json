{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hi-builder.pattern-page-spec.v2",
  "title": "HUI TPP Pattern PageSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "industry",
    "product",
    "id",
    "title",
    "page_kind",
    "pattern_contract",
    "portal",
    "preview"
  ],
  "properties": {
    "schema_version": {"const": "pattern-page-spec.v2"},
    "industry": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "product": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "page_kind": {"enum": ["form", "table", "card", "switch", "card-tabs", "details"]},
    "pattern_contract": {"type": "string", "minLength": 1},
    "alternate_pattern_contract": {"type": "string", "minLength": 1},
    "default_view": {"enum": ["card", "table"]},
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_top_menu", "section", "tab_title", "active_side_menu", "side_menus"],
      "properties": {
        "active_top_menu": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1},
        "tab_title": {"type": "string", "minLength": 1},
        "active_side_menu": {"type": "string", "minLength": 1},
        "side_menus": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sideMenu"}}
      }
    },
    "filters": {"type": "array", "items": {"type": "object"}},
    "toolbar_actions": {"type": "array", "items": {"type": "object"}},
    "columns": {"type": "array", "items": {"type": "object"}},
    "page_size": {"type": "integer", "minimum": 1},
    "detail_tabs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "sections"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/detailSection"}
          }
        }
      }
    },
    "form_sections": {"type": "array", "items": {"type": "object"}},
    "form_tabs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "section_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "form_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "card_tabs": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/cardTab"}
    },
    "summary_fields": {"type": "array", "items": {"$ref": "#/$defs/detailField"}},
    "detail_sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/detailSection"}},
    "active_detail_section": {"type": "string", "minLength": 1},
    "related_tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "columns"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "columns": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alt"],
      "properties": {"alt": {"type": "string", "minLength": 1}}
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formModel": {"type": "object"},
        "filters": {"type": "object"},
        "rows": {"type": "array", "items": {"type": "object"}},
        "total": {"type": "integer", "minimum": 0},
        "cardTabRows": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object"}}},
        "detailValues": {"type": "object"},
        "relatedTableRows": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object"}}},
        "detailMedia": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "src": {"type": "string", "minLength": 1},
            "thumbnails": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  },
  "$defs": {
    "sideMenu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "icon"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "icon": {"type": "string", "minLength": 1},
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "detailField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "tone": {"enum": ["default", "success", "warning", "danger", "info"]},
        "kind": {"enum": ["text", "image", "card", "password", "biometric"]}
      }
    },
    "detailSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "fields"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/detailField"}}
      }
    },
    "cardTab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "card_profile", "pattern_contract"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "card_profile": {"type": "string", "minLength": 1},
        "pattern_contract": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"page_kind": {"const": "switch"}}},
      "then": {"required": ["alternate_pattern_contract", "default_view"]}
    },
    {
      "if": {"properties": {"page_kind": {"const": "card-tabs"}}},
      "then": {"required": ["card_tabs"]}
    },
    {
      "if": {"properties": {"page_kind": {"const": "details"}}},
      "then": {"required": ["detail_sections"]}
    }
  ]
}
