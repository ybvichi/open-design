{
  "schema_version": "pattern-page-spec.v2",
  "industry": "general",
  "product": "isc",
  "id": "employee-access-identity-approval",
  "title": "员工门禁身份审批",
  "page_kind": "form",
  "pattern_contract": "form/sidebar-step-bar.json",
  "portal": {
    "active_top_menu": "人员通行",
    "section": "门禁管理",
    "tab_title": "员工门禁身份审批",
    "active_side_menu": "identity-approval",
    "side_menus": [
      {
        "id": "access-management",
        "label": "门禁管理",
        "icon": "h-icon-lock",
        "children": [
          {"id": "identity-approval", "label": "身份审批"},
          {"id": "access-policy", "label": "权限配置"}
        ]
      }
    ]
  },
  "form_sections": [
    {
      "id": "identity",
      "title": "员工身份",
      "description": "核对申请人的基础身份与所属组织信息。",
      "fields": [
        {"key": "employeeNo", "label": "员工工号", "kind": "input", "placeholder": "请输入员工工号", "required": true},
        {"key": "employeeName", "label": "员工姓名", "kind": "input", "placeholder": "请输入员工姓名", "required": true},
        {"key": "department", "label": "所属部门", "kind": "select", "placeholder": "请选择所属部门", "options": ["研发中心", "行政管理部", "生产运营部", "安保部"], "required": true},
        {"key": "position", "label": "岗位", "kind": "input", "placeholder": "请输入岗位"},
        {"key": "phone", "label": "手机号码", "kind": "input", "placeholder": "请输入手机号码", "required": true},
        {"key": "identityType", "label": "身份类型", "kind": "radio", "options": ["正式员工", "外包人员", "实习人员"], "wide": true, "required": true}
      ]
    },
    {
      "id": "access",
      "title": "门禁权限",
      "description": "配置员工可通行的区域、时段及身份凭证。",
      "fields": [
        {"key": "accessAreas", "label": "通行区域", "kind": "select", "multiple": true, "placeholder": "请选择通行区域", "options": ["总部园区东门", "研发楼一层", "研发楼三层", "员工餐厅", "地下停车场"], "wide": true, "required": true},
        {"key": "accessPeriod", "label": "通行时段", "kind": "select", "placeholder": "请选择通行时段", "options": ["工作日 08:00-20:00", "每日 07:00-23:00", "全天通行"], "required": true},
        {"key": "validity", "label": "权限有效期", "kind": "date-range", "wide": true, "required": true},
        {"key": "credentialTypes", "label": "身份凭证", "kind": "checkbox", "options": ["员工卡", "人脸", "指纹"], "wide": true, "required": true},
        {"key": "antiPassback", "label": "启用反潜回", "kind": "switch"},
        {"key": "accessReason", "label": "申请说明", "kind": "textarea", "placeholder": "请输入门禁权限申请说明", "wide": true}
      ]
    },
    {
      "id": "approval",
      "title": "审批设置",
      "description": "确认审批流程与生效方式后提交配置。",
      "fields": [
        {"key": "approvalFlow", "label": "审批流程", "kind": "select", "placeholder": "请选择审批流程", "options": ["直属主管 → 安保负责人", "部门负责人 → 园区管理员", "安保负责人直接审批"], "wide": true, "required": true},
        {"key": "approver", "label": "当前审批人", "kind": "select", "placeholder": "请选择审批人", "options": ["李明 / 研发中心主管", "周倩 / 行政管理部负责人", "王磊 / 园区安保负责人"], "wide": true, "required": true},
        {"key": "effectiveMode", "label": "生效方式", "kind": "radio", "options": ["审批通过后立即生效", "指定日期生效"], "wide": true},
        {"key": "notifyEmployee", "label": "通知申请人", "kind": "switch"},
        {"key": "approvalRemark", "label": "审批备注", "kind": "textarea", "placeholder": "请输入审批备注", "wide": true}
      ]
    }
  ],
  "preview": {
    "formModel": {
    "employeeNo": "HIK20260817023",
    "employeeName": "陈思远",
    "department": "研发中心",
    "position": "前端开发工程师",
    "phone": "138****5632",
    "identityType": "正式员工",
    "accessAreas": ["总部园区东门", "研发楼一层", "研发楼三层"],
    "accessPeriod": "工作日 08:00-20:00",
    "validity": ["2026-08-17 00:00:00", "2027-08-16 23:59:59"],
    "credentialTypes": ["员工卡", "人脸"],
    "antiPassback": true,
    "accessReason": "因日常研发工作需要，申请总部园区及研发楼门禁权限。",
    "approvalFlow": "直属主管 → 安保负责人",
    "approver": "李明 / 研发中心主管",
    "effectiveMode": "审批通过后立即生效",
    "notifyEmployee": true,
      "approvalRemark": "请核对员工身份与权限范围后审批。"
    }
  },
  "form_actions": ["上一步", "下一步", "取消"]
}
