{
  "schema_version": "pattern-page-spec.v2",
  "industry": "general",
  "product": "isc",
  "id": "blacklist-vehicle-config-isc",
  "title": "黑名单车辆配置",
  "page_kind": "form",
  "pattern_contract": "form/first-level-grouping.json",
  "portal": {
    "active_top_menu": "车辆通行",
    "section": "车辆配置",
    "tab_title": "黑名单车辆配置",
    "active_side_menu": "blacklist-vehicle",
    "side_menus": [
      {
        "id": "vehicle-config",
        "label": "车辆配置",
        "icon": "h-icon-details",
        "children": [
          {"id": "blacklist-vehicle", "label": "黑名单车辆配置"},
          {"id": "control-policy", "label": "管控策略"}
        ]
      }
    ]
  },
  "form_actions": ["保存配置", "取消"],
  "form_sections": [
    {
      "id": "basic",
      "title": "黑名单基本信息",
      "fields": [
        {"key": "listName", "label": "名单名称", "kind": "input", "placeholder": "请输入名单名称", "required": true},
        {"key": "controlType", "label": "管控类型", "kind": "select", "options": ["禁止通行", "重点关注", "临时布控"], "placeholder": "请选择管控类型", "required": true},
        {"key": "enabled", "label": "启用状态", "kind": "switch"}
      ]
    },
    {
      "id": "vehicle",
      "title": "车辆信息",
      "fields": [
        {"key": "plateNo", "label": "车牌号码", "kind": "input", "placeholder": "请输入车牌号码", "required": true},
        {"key": "plateColor", "label": "车牌颜色", "kind": "select", "options": ["蓝色", "黄色", "绿色", "白色", "黑色"], "placeholder": "请选择车牌颜色", "required": true},
        {"key": "vehicleType", "label": "车辆类型", "kind": "select", "options": ["小型汽车", "大型汽车", "新能源汽车", "摩托车"], "placeholder": "请选择车辆类型"},
        {"key": "ownerName", "label": "车主姓名", "kind": "input", "placeholder": "请输入车主姓名"},
        {"key": "ownerPhone", "label": "联系电话", "kind": "input", "placeholder": "请输入联系电话"},
        {"key": "vehicleBrand", "label": "车辆品牌", "kind": "input", "placeholder": "请输入车辆品牌"}
      ]
    },
    {
      "id": "policy",
      "title": "管控策略",
      "fields": [
        {"key": "effectiveTime", "label": "生效时间", "kind": "date-range", "required": true},
        {"key": "controlAreas", "label": "布控区域", "kind": "select", "multiple": true, "options": ["园区东门", "园区西门", "地下车库", "访客停车区"], "placeholder": "请选择布控区域", "required": true},
        {"key": "interceptLevel", "label": "拦截等级", "kind": "radio", "options": ["一般", "重要", "紧急"]},
        {"key": "alarmEnabled", "label": "命中告警", "kind": "switch"},
        {"key": "reason", "label": "列入原因", "kind": "textarea", "placeholder": "请输入列入黑名单的原因", "wide": true}
      ]
    }
  ],
  "preview": {
    "formModel": {
    "listName": "重点管控车辆名单",
    "controlType": "禁止通行",
    "enabled": true,
    "plateNo": "浙A·7K892",
    "plateColor": "蓝色",
    "vehicleType": "小型汽车",
    "ownerName": "王海峰",
    "ownerPhone": "138****6721",
    "vehicleBrand": "大众帕萨特",
    "effectiveTime": ["2026-08-17 00:00:00", "2026-12-31 23:59:59"],
    "controlAreas": ["园区东门", "地下车库"],
    "interceptLevel": "重要",
    "alarmEnabled": true,
      "reason": "该车辆存在多次违规闯入记录，列入重点管控黑名单。"
    }
  }
}
